rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /uploads/{uid}/{allPaths=**} { allow read,write: if request.auth != null && request.auth.uid == uid; }
  match /generated/{uid}/{allPaths=**} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
 }
}